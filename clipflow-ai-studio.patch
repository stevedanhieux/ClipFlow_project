+import React, { useRef, useState } from 'react';
+import { Project, Scene } from '../types';
+import { saveExportReference } from '../services/exportLibrary';
+import { ExportLibrary } from './ExportLibrary';
+
+async function api(url: string, body: any) {
+  const response = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
+  const data = await response.json(); if (!response.ok) throw new Error(data.error || 'Request failed'); return data;
+}
+export function DirectorWorkspace({ project, onUpdate }: { project: Project; onUpdate: (p: Project) => void }) {
+  const [tab, setTab] = useState<'files' | 'social'>('files');
+  const [provider, setProvider] = useState('gemini'); const [model, setModel] = useState('');
+  const [command, setCommand] = useState(''); const [social, setSocial] = useState('');
+  const [message, setMessage] = useState(''); const [busy, setBusy] = useState(false);
+  const [draft, setDraft] = useState<Project | null>(null); const [selected, setSelected] = useState<string[]>([]);
+  const [history, setHistory] = useState<Project[]>([]); const [future, setFuture] = useState<Project[]>([]);
+  const [preferences, setPreferences] = useState(() => localStorage.getItem('clipflow_preferences') || '');
+  const [remember, setRemember] = useState(false); const [refresh, setRefresh] = useState(0);
+  const [playIndex, setPlayIndex] = useState(0); const video = useRef<HTMLVideoElement>(null);
+  const [renderedUrl, setRenderedUrl] = useState('');
+  const shown = draft || project; const scene = shown.scenes[playIndex];
+  const commit = (next: Project) => { setHistory(h => [...h.slice(-29), project]); setFuture([]); onUpdate(next); setDraft(null); setPlayIndex(0); setSelected([]); };
+  const operation = async (work: () => Promise<void>) => { setBusy(true); setMessage('Working…'); try { await work(); } catch (e: any) { setMessage(e.message); } finally { setBusy(false); } };
+  const loadMedia = async (url: string, title: string, image = false): Promise<Scene> => {
+    let duration = 5;
+    if (!image) duration = await new Promise<number>((resolve, reject) => {
+      const el = document.createElement('video'); el.preload = 'metadata'; el.src = url;
+      const timer = setTimeout(() => { el.src = ''; reject(new Error('Video metadata timed out.')); }, 20000);
+      el.onloadedmetadata = () => { clearTimeout(timer); if (!Number.isFinite(el.duration) || el.duration <= 0) reject(new Error('Video duration is unavailable.')); else resolve(el.duration); el.removeAttribute('src'); el.load(); };
+      el.onerror = () => { clearTimeout(timer); reject(new Error('This browser cannot preview this video. Try MP4 (H.264).')); };
+    });
+    return { id: crypto.randomUUID(), sceneNumber: 1, caption: '', voiceover: '', duration, sourceDuration: duration, trimStart: 0, sourceVolume: 1, mediaUrl: url, mediaType: image ? 'image' : 'video', visualDirection: title, accentColor: '#f43f5e', focalPoint: {x:0.5,y:0.5}, zoomScale: 1, transition: 'fade' };
+  };
+  const importFiles = (files: File[]) => operation(async () => {
+    const additions: Scene[] = [];
