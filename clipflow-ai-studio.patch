+    const { title, scriptSummary, niche = 'general', targetPlatform = 'all' } = req.body;
+
+    const response = await getAI().models.generateContent({
+      model: process.env.GEMINI_MODEL || 'gemini-2.5-flash',
+      contents: `Generate viral caption packages for short-form video:
