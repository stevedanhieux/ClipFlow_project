+      },
+    },
+  };
+}
+
+// Endpoint: Generate Full Video Storyboard & Smart Scenes from Prompt/File/Image
+app.post('/api/gemini/generate-storyboard', async (req         , res          ) => {
+  try {
+    const {
+      promptText,
+      sourceType,
