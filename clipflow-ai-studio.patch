diff --git a/build-server.mjs b/build-server.mjs
new file mode 100644
--- /dev/null
+++ b/build-server.mjs
@@ -0,0 +1,6 @@
+import { stripTypeScriptTypes } from 'node:module';
+import { readFileSync, writeFileSync } from 'node:fs';
+for (const name of ['server', 'studioServer']) {
+  const source = readFileSync(`${name}.ts`, 'utf8').replace("from './studioServer'", "from './studioServer.js'");
+  writeFileSync(`${name}.js`, stripTypeScriptTypes(source));
+}
