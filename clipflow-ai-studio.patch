+    if (imageBase64 && imageMimeType) {
+      contentsPayload[0].parts.push({
+        inlineData: {
+          mimeType: imageMimeType,
+          data: imageBase64,
+        },
+      });
+      contentsPayload[0].parts.push({
+        text: `Analyze this image and the user's brief: "${rawContent || 'Turn this photo into an engaging viral short-form video clip'}". Generate the video storyboard.`,
+      });
+    } else {
+      contentsPayload[0].parts.push({
+        text: `Here is the input content/script to convert into a short-form video:\n\n${rawContent}`,
+      });
+    }
+
+    const response = await getAI().models.generateContent({
+      model: process.env.GEMINI_MODEL || 'gemini-2.5-flash',
+      contents: contentsPayload,
