+import { spawn } from 'node:child_process';
+import path from 'node:path';
+import { GoogleGenAI } from '@google/genai';
+
+const root = path.resolve('data');
+const media = path.join(root, 'media');
+const jobs = new Map                                                          ();
+const extensions = new Set(['.mp4', '.webm', '.mov', '.m4v', '.jpg', '.jpeg', '.png', '.mp3', '.wav']);
+export async function run(command        , args          )                  {
+  return new Promise((resolve, reject) => {
+    const child = spawn(process.env[`${command.toUpperCase().replace('-', '_')}_PATH`] || command, args, { windowsHide: true }); let output = ''; let errors = '';
+    child.stdout.on('data', data => output = (output + data).slice(-100000));
+    child.stderr.on('data', data => errors = (errors + data).slice(-4000));
+    child.on('error', () => reject(new Error(`${command} is unavailable. Install it and restart ClipFlow.`)));
+    child.on('exit', code => code === 0 ? resolve(output) : reject(new Error(errors || `${command} failed (${code})`)));
+  });
+}
+export async function askAI(provider        , model        , prompt        )               {
+  let text = '';
+  if (provider === 'gemini') {
+    if (!process.env.GEMINI_API_KEY) throw new Error('Set GEMINI_API_KEY in .env.');
+    const ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });
+    text = (await ai.models.generateContent({ model: model || process.env.GEMINI_MODEL || 'gemini-2.5-flash', contents: prompt, config: { responseMimeType: 'application/json' } })).text || '';
+  } else {
+    let url        ; let body     ; let headers                         = { 'Content-Type': 'application/json' };
+    if (provider === 'ollama') {
+      url = `${process.env.OLLAMA_URL || 'http://127.0.0.1:11434'}/api/chat`;
+      body = { model: model || process.env.OLLAMA_MODEL || 'llama3.2', stream: false, format: 'json', messages: [{ role: 'user', content: prompt }] };
+    } else if (provider === 'claude') {
+      if (!process.env.ANTHROPIC_API_KEY) throw new Error('Set ANTHROPIC_API_KEY in .env. Claude API is paid.');
+      url = 'https://api.anthropic.com/v1/messages';
+      headers = { ...headers, 'x-api-key': process.env.ANTHROPIC_API_KEY, 'anthropic-version': '2023-06-01' };
+      body = { model: model || process.env.CLAUDE_MODEL || 'claude-sonnet-4-5', max_tokens: 8192, messages: [{ role: 'user', content: prompt }] };
+    } else if (provider === 'openai' || provider === 'compatible') {
+      const key = provider === 'openai' ? process.env.OPENAI_API_KEY : process.env.COMPATIBLE_API_KEY;
+      if (!key) throw new Error('Set the provider API key in .env.');
+      const base = provider === 'openai' ? 'https://api.openai.com/v1' : process.env.COMPATIBLE_BASE_URL;
+      if (!base) throw new Error('Set COMPATIBLE_BASE_URL in .env.');
+      url = `${base.replace(/\/$/, '')}/chat/completions`; headers.Authorization = `Bearer ${key}`;
+      body = { model: model || (provider === 'openai' ? process.env.OPENAI_MODEL || 'gpt-4.1-mini' : process.env.COMPATIBLE_MODEL), messages: [{ role: 'user', content: prompt }], response_format: { type: 'json_object' } };
+    } else throw new Error('Choose a supported AI provider.');
+    const response = await fetch(url, { method: 'POST', headers, body: JSON.stringify(body), signal: AbortSignal.timeout(180000) });
+    const data      = await response.json();
+    if (!response.ok) throw new Error(data.error?.message || `Provider returned ${response.status}`);
+    text = provider === 'ollama' ? data.message?.content : provider === 'claude' ? data.content?.find((v     ) => v.type === 'text')?.text : data.choices?.[0]?.message?.content;
+  }
+  return JSON.parse((text || '').replace(/^```(?:json)?\s*|\s*```$/g, '').trim());
+}
+function localFile(url        ) {
+  const name = url?.replace('/media/', '');
+  if (!url?.startsWith('/media/') || !/^[a-zA-Z0-9_.-]+$/.test(name)) throw new Error('Import the media into ClipFlow first.');
+  return path.join(media, name);
+}
+export async function installStudio(app         ) {
+  await mkdir(media, { recursive: true });
+  app.use('/media', express.static(media));
+  app.delete('/api/studio/export', async (req, res) => {
+    try {
+      const url = String(req.body.url || '');
+      const match = /^\/media\/([a-f0-9-]{36})\.mp4$/.exec(url);
+      if (!match) throw new Error('Invalid export reference.');
+      // Only renderer-created files have a matching concat manifest; uploads are protected.
+      await readFile(path.join(root, match[1], 'concat.txt'));
