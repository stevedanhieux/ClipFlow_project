+      imageBase64,
+    } = req.body;
+
+    const rawContent = (promptText || '').trim();
+    if (!rawContent && !imageBase64) {
+      return res.status(400).json({ error: 'Please provide either text/script content or an uploaded image.' });
+    }
+
+    const platformGuidance = {
+      tiktok: 'Ultra-fast pacing (under 3.5s per scene), intense opening hook, high-energy vocabulary, text overlays optimized for mobile safe zones.',
+      shorts: 'High retention focus, curiosity gap in first 2 seconds, punchy visual cuts, clear loop potential.',
+      reels: 'Aesthetic, cinematic framing, conversational yet authoritative tone, clean visual flow.',
+      cross_platform: 'Universal high-engagement structure adaptable across TikTok, Shorts, and Reels.',
