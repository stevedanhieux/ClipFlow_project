@@ -0,0 +1,29 @@
+export interface SavedExport { id: string; title: string; createdAt: number; blob?: Blob; url?: string }
+function database(): Promise<IDBDatabase> {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open('clipflow-exports', 1);
+    request.onupgradeneeded = () => request.result.createObjectStore('exports', { keyPath: 'id' });
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+async function transaction<T>(mode: IDBTransactionMode, action: (store: IDBObjectStore) => IDBRequest<T>): Promise<T> {
+  const db = await database();
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction('exports', mode);
+    const request = action(tx.objectStore('exports'));
+    tx.oncomplete = () => { resolve(request.result); db.close(); };
+    tx.onabort = tx.onerror = () => { reject(tx.error); db.close(); };
+  });
+}
+export const listExports = () => transaction('readonly', store => store.getAll()) as Promise<SavedExport[]>;
