+        systemInstruction: `You are a viral social media growth hacker. Generate top-tier copy with:
+1. High-CTR hooks (first 80 chars before "more")
+2. Engaging body copy with curiosity and CTA
+3. 6 to 10 trending hashtags categorized by niche and broad discovery.
+Format response strictly in JSON.`,
+        temperature: 0.75,
+        responseMimeType: 'application/json',
+        responseSchema: {
+          type: Type.OBJECT,
+          properties: {
+            tiktok: {
+              type: Type.OBJECT,
+              properties: {
+                hook: { type: Type.STRING },
+                caption: { type: Type.STRING },
+                hashtags: { type: Type.ARRAY, items: { type: Type.STRING } },
+                callToAction: { type: Type.STRING },
+              },
+              required: ['hook', 'caption', 'hashtags', 'callToAction'],
+            },
+            shorts: {
+              type: Type.OBJECT,
+              properties: {
+                hook: { type: Type.STRING },
+                caption: { type: Type.STRING },
+                hashtags: { type: Type.ARRAY, items: { type: Type.STRING } },
+                callToAction: { type: Type.STRING },
+              },
+              required: ['hook', 'caption', 'hashtags', 'callToAction'],
+            },
+            reels: {
+              type: Type.OBJECT,
+              properties: {
+                hook: { type: Type.STRING },
+                caption: { type: Type.STRING },
+                hashtags: { type: Type.ARRAY, items: { type: Type.STRING } },
+                callToAction: { type: Type.STRING },
+              },
+              required: ['hook', 'caption', 'hashtags', 'callToAction'],
+            },
+          },
+          required: ['tiktok', 'shorts', 'reels'],
+        },
+      },
+    });
+
+    const parsed = JSON.parse(response.text || '{}');
+    return res.json(parsed);
+  } catch (err     ) {
+    console.error('Error generating viral captions:', err);
+    return res.status(503).json({ error: 'Caption generation failed. Check Gemini configuration and quota.' });
+  }
+});
+
+// Production or Vite development middleware setup
+function getAI() { if (!ai) throw new Error('Configure GEMINI_API_KEY to use Gemini.'); return ai; }
+
+async function startServer() {
+  await installStudio(app);
+  if (!isProduction) {
+    const { createServer: createViteServer } = await import('vite');
+    const vite = await createViteServer({
+      server: { middlewareMode: true },
+      appType: 'spa',
+    });
+    app.use(vite.middlewares);
+  } else {
+    const distPath = path.join(__dirname, 'dist');
+    app.use(express.static(distPath));
+    app.get('*', (_req         , res          ) => {
+      res.sendFile(path.join(distPath, 'index.html'));
+    });
+  }
+
+  app.listen(PORT, process.env.HOST || '0.0.0.0', () => {
+    console.log(`[ClipFlow] Server listening on http://0.0.0.0:${PORT}`);
+  });
+}
+
+startServer().catch(err => {
+  console.error('[ClipFlow] Failed to start server:', err);
+});
