+import { installStudio } from './studioServer.js';
+import express, {                             } from 'express';
+import path from 'path';
+import { fileURLToPath } from 'url';
+import dotenv from 'dotenv';
+import { GoogleGenAI, Type } from '@google/genai';
+
+dotenv.config();
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+
+const isProduction = process.env.NODE_ENV === 'production';
+const PORT = Number(process.env.PORT) || 3000;
+
+const app = express();
+app.use(express.json({ limit: '50mb' }));
+app.use(express.urlencoded({ extended: true, limit: '50mb' }));
+
+// Shared server-side Gemini client per gemini-api skill guide
+const ai = process.env.GEMINI_API_KEY ? new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY }) : null;
+
+// Fallback scene generator if Gemini is unavailable or rate-limited
+function generateSmartFallbackStoryboard(prompt        , platform        , sourceType        ) {
+  const cleanPrompt = prompt.trim() || 'Exciting creator update';
+  const sentences = cleanPrompt
+    .split(/[.\n;]+/)
+    .map(s => s.trim())
+    .filter(s => s.length > 5);
+
+  const fallbackScenes = [
+    {
+      sceneNumber: 1,
+      caption: sentences[0]?.slice(0, 48) || 'Wait until you see this secret...',
+      voiceover: sentences[0] || 'Stop scrolling because this changes everything you know about creation.',
+      duration: 3.0,
+      transition: 'zoom_in',
+      visualDirection: 'Hook shot with fast push-in and vibrant lighting',
+      focalPoint: { x: 0.5, y: 0.45 },
+      zoomScale: 1.15,
+      accentColor: '#f43f5e',
+    },
+    {
+      sceneNumber: 2,
+      caption: sentences[1]?.slice(0, 48) || 'Here is the step most people miss',
+      voiceover: sentences[1] || 'Step 1 is focusing on what your audience actually needs right now.',
+      duration: 3.2,
+      transition: 'whip_pan',
+      visualDirection: 'Dynamic pan across the core subject with high focus',
+      focalPoint: { x: 0.48, y: 0.5 },
+      zoomScale: 1.08,
+      accentColor: '#3b82f6',
+    },
+    {
+      sceneNumber: 3,
+      caption: sentences[2]?.slice(0, 48) || 'The game-changing breakthrough',
+      voiceover: sentences[2] || 'Notice how immediate results compound when you automate the editing.',
+      duration: 3.0,
+      transition: 'glitch',
+      visualDirection: 'Punchy transition with micro-zoom emphasizing key metric',
+      focalPoint: { x: 0.52, y: 0.48 },
+      zoomScale: 1.2,
+      accentColor: '#8b5cf6',
+    },
+    {
+      sceneNumber: 4,
+      caption: sentences[3]?.slice(0, 48) || 'Try this in your next video!',
+      voiceover: sentences[3] || 'Save this for your next video and follow for daily creator tips!',
+      duration: 2.8,
+      transition: 'fade',
+      visualDirection: 'Outro framing with clear CTA and memorable sign-off',
+      focalPoint: { x: 0.5, y: 0.5 },
+      zoomScale: 1.05,
+      accentColor: '#10b981',
+    },
+  ];
+
+  return {
+    title: cleanPrompt.slice(0, 40) || 'Viral Short-Form Clip',
+    hook: sentences[0] || 'Wait until you see this...',
